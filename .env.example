# Copy to .env.local and fill in. Variable names only here; never commit real values.

# --- Sign in ---
# First visit shows a one-time "create the owner account" page. On localhost nothing is needed.
# For a hosted deployment, set SETUP_TOKEN and enter it on that page so only you can claim the owner account.
SETUP_TOKEN=
# Set to 1 to require every user to turn on two-factor sign-in.
REQUIRE_MFA=
# Breached-password check (sends only a 5 character hash prefix). Set to 0 to disable.
AUTH_CHECK_BREACHED=1

# --- App ---
# Public base URL used in mockup links and unsubscribe links inside emails.
# Must be a public https URL before any real email is sent.
APP_BASE_URL=http://localhost:3000
# 32+ random characters. Signs unsubscribe links and encrypts two-factor secrets. Required on Vercel.
# Locally, if blank, one is generated and kept in data/.secret.
APP_SECRET=
# Postgres connection string (Neon or Vercel Postgres, pooled URL). Required in production.
# Leave blank locally to use an embedded PGlite database in ./data/pglite.
DATABASE_URL=

# --- Scheduling (Windows Task Scheduler calls the app with this secret) ---
# 32+ random characters. Used by scripts/run-campaign.ps1; keep it only in .env.local.
CRON_SECRET=

# --- Discovery source ---
# osm (default, free, no key) or google (paid Places API)
DISCOVERY_PROVIDER=osm
# Required for osm: an email or URL that identifies you to OpenStreetMap services.
OSM_CONTACT=

# --- Google Places API (New), only if DISCOVERY_PROVIDER=google ---
GOOGLE_PLACES_API_KEY=
# Hard cap on Text Search pages (20 results each) per query. Default 1, max 3.
PLACES_MAX_PAGES=1

# --- PayPal (sandbox first; the Connections page has a Test connection button) ---
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Live money stays blocked until you set this to 1 on purpose.
PAYPAL_ALLOW_LIVE=
# Testing only: a fake PayPal on this same computer (http://127.0.0.1:PORT). Any other value is ignored.
PAYPAL_TEST_BASE_URL=

# --- Resend ---
RESEND_API_KEY=
# Daily send cap guardrail. Default 10.
SEND_DAILY_CAP=10

# --- Brand: Aquila Digital (the only brand for now; see config/brands.js) ---
SENDER_NAME=
SENDER_EMAIL=
REPLY_TO_EMAIL=
# Real physical mailing address, required by CAN-SPAM. Sending is blocked without it.
MAILING_ADDRESS=
BRAND_WEBSITE=
